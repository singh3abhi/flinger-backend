version: 2
updates:
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    target-branch: uat-release
    groups:
      nestjs:
        patterns: ['@nestjs/*']
  - package-ecosystem: docker
    directory: /
    schedule:
      interval: weekly
    target-branch: uat-release
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    target-branch: uat-release
