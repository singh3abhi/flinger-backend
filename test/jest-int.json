{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/integration/.*\\.int-spec\\.ts$",
  "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }] },
  "moduleNameMapper": { "^@/(.*)$": "<rootDir>/src/$1" },
  "testEnvironment": "node",
  "maxWorkers": 1,
  "testTimeout": 30000
}
