  "info": {
    "title": "Flinger API",
    "description": "REST API for the Flinger dating app. All errors are RFC 7807 problem+json with a stable `code`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ClientConfigDto": {
        "type": "object",
        "properties": {
          "minSupportedAppVersion": {
            "type": "string"
          },
          "legalVersion": {
            "type": "string"
          },
          "flags": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "photosMin": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "photosMax": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "promptsRequired": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "promptMaxLength": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "bioMaxLength": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "messageMaxLength": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "dailyLikes": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "minAge": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "photosMin",
              "photosMax",
              "promptsRequired",
              "promptMaxLength",
              "bioMaxLength",
              "messageMaxLength",
              "dailyLikes",
              "minAge"
            ]
          }
        },
        "required": [
          "minSupportedAppVersion",
          "legalVersion",
          "flags",
          "limits"
        ]
      },
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "RequestOtpResultDto": {
        "type": "object",
        "properties": {
          "resendAvailableInSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "expiresInSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "resendAvailableInSeconds",
          "expiresInSeconds"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "device": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 64,
                "pattern": "^[\\w-]+$"
              },
              "platform": {
                "type": "string",
                "enum": [
                  "ios",
                  "android",
                  "web"
                ]
              }
            },
            "required": [
              "id",
              "platform"
            ]
          }
        },
        "required": [
          "email",
          "code",
          "device"
        ]
      },
      "AuthResultDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "active",
                  "paused",
                  "suspended",
                  "deleted"
                ]
              },
              "isNewUser": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "status",
              "isNewUser"
            ]
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "user"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 20,
            "maxLength": 200
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "paused",
              "suspended",
              "deleted"
            ]
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "nullable": true
          },
          "onboardingCompleted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "status",
          "email",
          "onboardingCompleted",
          "createdAt"
        ]
      },
      "MyProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 30,
            "nullable": true
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "nullable": true
          },
          "age": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "gender": {
            "type": "string",
            "enum": [
              "woman",
              "man",
              "non_binary",
              null
            ],
            "nullable": true
          },
          "heightCm": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "kidsStatus": {
            "type": "string",
            "enum": [
              "have_kids",
              "no_kids",
              null
            ],
            "nullable": true
          },
          "familyPlans": {
            "type": "string",
            "enum": [
              "dont_want_kids",
              "want_kids",
              "open_to_kids",
              "not_sure",
              null
            ],
            "nullable": true
          },
          "religion": {
            "type": "string",
            "enum": [
              "agnostic",
              "atheist",
              "buddhist",
              "catholic",
              "christian",
              "hindu",
              "jain",
              "jewish",
              "muslim",
              "sikh",
              "zoroastrian",
              "spiritual",
              "religious",
              "other",
              null
            ],
            "nullable": true
          },
          "politics": {
            "type": "string",
            "enum": [
              "apolitical",
              "moderate",
              "left",
              "right",
              "socialist",
              "communist",
              null
            ],
            "nullable": true
          },
          "bio": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "interestedIn": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "men",
                "women",
                "non_binary"
              ]
            }
          },
          "hopingToFind": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "long_term_relationship",
                "life_partner",
                "casual",
                "intimacy_no_commitment",
                "marriage",
                "ethical_non_monogamy"
              ]
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ambition",
                "confidence",
                "curiosity",
                "emotional_intelligence",
                "kindness",
                "honesty",
                "sense_of_humor",
                "empathy",
                "open_mindedness",
                "good_communication",
                "emotional_availability",
                "independence",
                "loyalty",
                "growth_mindset",
                "respect"
              ]
            }
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "black_lives_matter",
                "disability_rights",
                "end_religious_hate",
                "environmental_protection",
                "feminism",
                "human_rights",
                "immigrant_rights",
                "indigenous_rights",
                "lgbtq_plus_rights",
                "neurodiversity",
                "reproductive_rights",
                "stop_asian_hate",
                "trans_rights",
                "volunteering",
                "voting_rights"
              ]
            }
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "promptId": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "answer": {
                  "type": "string"
                },
                "position": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                }
              },
              "required": [
                "promptId",
                "text",
                "answer",
                "position"
              ]
            }
          },
          "onboarding": {
            "type": "object",
            "properties": {
              "completed": {
                "type": "boolean"
              },
              "nextStep": {
                "type": "string",
                "enum": [
                  "basics",
                  "gender",
                  "interested_in",
                  "hoping_to_find",
                  "height",
                  "values",
                  "photos",
                  "prompts",
                  "location",
                  "consents",
                  null
                ],
                "nullable": true
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "basics",
                    "gender",
                    "interested_in",
                    "hoping_to_find",
                    "height",
                    "values",
                    "photos",
                    "prompts",
                    "location",
                    "consents"
                  ]
                }
              }
            },
            "required": [
              "completed",
              "nextStep",
              "missing"
            ]
          }
        },
