# Copy to .env for local development. Never commit .env.

# local | uat | production   (which deployment this is)
APP_ENV=local
# development | test | production   (Node/library behaviour)
NODE_ENV=development
# api | realtime | worker   (which entry point the container runs; informational in-process)
APP_MODE=api
PORT=4000
LOG_LEVEL=debug

# docker compose defaults (see docker-compose.yml)
DATABASE_URL=postgres://flinger:flinger@localhost:5432/flinger
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed web origins (mobile apps ignore CORS)
CORS_ORIGINS=

# Oldest app version the API still serves; older apps get "update required"
MIN_APP_VERSION=1.0.0
