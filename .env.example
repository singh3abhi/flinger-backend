# Copy to .env for local development. Never commit .env.

# local | uat | production   (which deployment this is)
APP_ENV=local
# development | test | production   (Node/library behaviour)
NODE_ENV=development
# api | realtime | worker   (which entry point the container runs; informational in-process)
APP_MODE=api
PORT=4000
LOG_LEVEL=debug

# docker compose defaults (see docker-compose.yml)
DATABASE_URL=postgres://flinger:flinger@localhost:5432/flinger
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed web origins (mobile apps ignore CORS)
CORS_ORIGINS=

# --- Auth (generate real values with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0123456789
OTP_PEPPER=dev-only-otp-pepper-change-me
# Emails that always get code 123456 and receive no email (never allowed in production)
OTP_TEST_EMAILS=qa@flinger.test
OTP_TEST_CODE=123456
# 0 locally; 1 behind a single load balancer so rate limits see the real client IP
TRUST_PROXY_HOPS=0

# --- Email (Mailpit locally: see http://localhost:8025) ---
MAIL_SMTP_URL=smtp://localhost:1025
MAIL_FROM="Flinger <no-reply@flinger.app>"

# --- Photo storage (SeaweedFS from docker compose; S3 in AWS) ---
S3_BUCKET=flinger-photos-local
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:8333
# Host devices upload to. The iOS simulator reaches localhost; the Android emulator needs http://10.0.2.2:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY_ID=flinger
S3_SECRET_ACCESS_KEY=flinger-dev-secret
S3_FORCE_PATH_STYLE=true
# auto_approve (local only) or manual
PHOTO_MODERATION=auto_approve

# Accept simulated GPS (iOS Simulator / Android emulator). Never true in production.
LOCATION_ALLOW_MOCKED=true

# Oldest app version the API still serves; older apps get "update required"
MIN_APP_VERSION=1.0.0
